{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint"],
  "categories": {
    "correctness": "off"
  },
  "ignorePatterns": ["**/__tests__/**"],
  "overrides": [
    {
      "files": [
        "src/pages/planner/lib/validation/**/*.ts",
        "src/pages/planner/lib/plannerValidation.ts",
        "src/pages/planner/lib/plannerValidationErrors.ts"
      ],
      "rules": {
        "complexity": ["error", { "max": 5 }],
        "max-depth": ["error", { "max": 2 }]
      }
    }
  ]
}
