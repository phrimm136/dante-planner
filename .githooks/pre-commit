#!/usr/bin/env bash
# Two guards on staged content: private-key material, and the mechanical format
# rules for architecture decision records (convention: docs/adr/README.md).
# Public certificates (BEGIN CERTIFICATE) pass — only key material is blocked.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

fail=0

# The literal is split so this hook's own source never matches its pattern.
pattern="BEGIN ([A-Z]+ )?PRIVATE ""KEY"

if git diff --cached -U0 | grep '^+' | grep -Eq "$pattern"; then
  echo "pre-commit: staged changes contain a private-key PEM block." >&2
  echo "Private keys never enter this repo — route them through Secrets Manager -> ESO." >&2
  echo "(offending additions:)" >&2
  git diff --cached -U0 --name-only | sed 's/^/  /' >&2
  fail=1
fi

staged=$(git diff --cached --name-only --diff-filter=ACM || true)

# The game data is a sibling checkout reached through an untracked symlink (ADR 200); a
# staged `static` path means the symlink or its target was added by mistake.
if echo "$staged" | grep -Eq '^static(/|$)'; then
  echo "pre-commit: 'static' is the data checkout's symlink and never a tracked path (ADR 200); run: git rm --cached -r static" >&2
  exit 1
fi

# The commit's own static.lock (the index copy) must name the data checkout's HEAD, whether the
# working-tree lock was already rewritten by `static lock` or not (ADR 200 @static @lock).
static_state=0
.claude/skills/static-checkout/bin/static check >/dev/null 2>&1 || static_state=$?
if [ "$static_state" -ne 2 ]; then
  data_head=$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_COMMON_DIR git -C static rev-parse HEAD 2>/dev/null || true)
  staged_lock=$(git show :static.lock 2>/dev/null | tr -d '[:space:]' || true)
  if [ -n "$data_head" ] && [ "$staged_lock" != "$data_head" ]; then
    echo "pre-commit: the data checkout is at $data_head but the staged static.lock says $staged_lock; run static lock and stage static.lock, or static sync" >&2
    exit 1
  fi
fi
records=$(echo "$staged" | grep -E '^docs/adr/[0-9]{3}-[a-z0-9-]+\.md$' || true)
strays=$(echo "$staged" | grep -E '^docs/adr/.+\.md$' \
       | grep -vE '^docs/adr/([0-9]{3}-[a-z0-9-]+|README|CLAUDE)\.md$' || true)

adr_fail() { echo "  $1 — $2" >&2; fail=1; }

if [[ -n "$strays" ]]; then
  echo "pre-commit: ADR filenames must be NNN-kebab-title.md" >&2
  echo "$strays" | sed 's/^/  /' >&2
  fail=1
fi

if [[ -n "$records" ]]; then
  echo "pre-commit: verifying architecture decision records" >&2

  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    body=$(git show ":$f")
    num=$(basename "$f" | cut -c1-3)

    head -1 <<<"$body" | grep -qE "^# ${num} " \
      || adr_fail "$f" "first line must be '# ${num} <kebab-title>'"

    grep -q '^## Decisions' <<<"$body" || adr_fail "$f" "missing '## Decisions'"
    grep -q '^## Takeaway' <<<"$body" || adr_fail "$f" "missing '## Takeaway'"

    # Every record bullet is tag-addressed, so a decision is citable as NNN @tag.
    untagged=$(echo "$body" | awk '
      /^## (Decisions|Superseded)/ {s=1; next}
      /^## / {s=0}
      s && /^- / && !/^- @/ {print substr($0,1,50)}' || true)
    [[ -z "$untagged" ]] || adr_fail "$f" "decision lines must start '- @'"

    # A superseded bullet names its successor, or the move is untraceable.
    dangling=$(echo "$body" | awk '
      /^## Superseded/ {s=1; next}
      /^## / {s=0}
      s && /^- @/ && !/→/ {print substr($0,1,50)}' || true)
    [[ -z "$dangling" ]] || adr_fail "$f" "superseded bullets need '→ NNN' or '→ fulfilled'"

    while IFS='|' read -r label pat; do
      [[ -z "$label" ]] && continue
      hit=$(echo "$body" | grep -nEi "$pat" | head -2 || true)
      [[ -z "$hit" ]] || adr_fail "$f" "$label — ${hit//$'\n'/ ; }"
    done <<'BANNED'
task path|docs/tasks/
task or phase number|\b(task|phase) [0-9]
date|20[0-9]{2}-[0-9]{2}-[0-9]{2}
account id|\b[0-9]{12}\b
role arn|arn:aws:
attribution|\buser (decision|answer|ruling)\b
session context|\b(this|the) session\b
BANNED

    for target in $(echo "$body" | sed -n 's/.*supersedes: \([0-9]\{3\}\).*/\1/p'); do
      compgen -G "docs/adr/${target}-*.md" >/dev/null \
        || adr_fail "$f" "supersedes $target, which does not exist"
    done

    dupes=$(compgen -G "docs/adr/${num}-*.md" | wc -l || true)
    (( dupes <= 1 )) || adr_fail "$f" "number $num is used by $dupes files"

    # Reported, never enforced: forced, corollary and summary bullets
    # legitimately carry no rejected alternative.
    bare=$(echo "$body" | awk '
      function close_bullet() { if (open && !rejected) print 1; open = 0; rejected = 0 }
      /^## / {close_bullet(); s = ($0 ~ /^## Decisions/); next}
      s && /^- @/ {close_bullet(); open = 1}
      open && /REJECTED/ {rejected = 1}
      END {close_bullet()}' | wc -l || true)
    (( bare == 0 )) || echo "  $f — note: $bare decision(s) with no REJECTED clause" >&2

  done <<< "$records"
fi

if echo "$staged" | grep -qx 'docs/debt.md'; then
  debt_cli=.claude/skills/debt-ledger/bin/debt
  ledger_dir=$(mktemp -d)
  trap 'rm -rf "$ledger_dir"' EXIT
  git show :docs/debt.md > "$ledger_dir/index.md"
  git show HEAD:docs/debt.md > "$ledger_dir/head.md" 2>/dev/null || : > "$ledger_dir/head.md"
  missing_count() { { "$debt_cli" doctor --file "$1" || true; } | sed -n '1s/.*, missing \([0-9]*\),.*/\1/p'; }
  index_missing=$(missing_count "$ledger_dir/index.md")
  head_missing=$(missing_count "$ledger_dir/head.md")
  if [[ -z "$index_missing" || -z "$head_missing" ]]; then
    echo "pre-commit: debt doctor printed no missing count; run $debt_cli doctor --file <ledger> to see why" >&2
    fail=1
  elif (( index_missing > head_missing )); then
    echo "pre-commit: docs/debt.md has $index_missing entries without a re-check line, HEAD has $head_missing; add the line or delete the entry" >&2
    fail=1
  fi
  check_state=0
  check_output=$("$debt_cli" check --file "$ledger_dir/index.md" 2>&1) || check_state=$?
  if (( check_state != 0 )); then
    echo "$check_output" >&2
    echo "pre-commit: delete the GONE entries or fix the BROKEN commands" >&2
    fail=1
  fi
fi

# Terraform auto-loads terraform.tfvars on every invocation of a stack, so a file with
# that name supplies variables no command names and no reviewer sees. The names below are
# environment-scoped and every var-file is passed explicitly. Checked against the working
# tree rather than the index, because *.tfvars is gitignored and never reaches a commit.
autoloaded=$(find terraform -mindepth 2 -maxdepth 2 -name 'terraform.tfvars' 2>/dev/null || true)
if [[ -n "$autoloaded" ]]; then
  echo "pre-commit: terraform.tfvars is auto-loaded and must not exist." >&2
  echo "Rename to <environment>.tfvars and pass it with -var-file:" >&2
  echo "$autoloaded" | sed 's/^/  /' >&2
  fail=1
fi

exit $fail
