#!/usr/bin/env python3
import os
import re
import signal
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

USAGE_TEXT = """usage: debt [--file <path>] <command> [--only <substring>]
       debt adr doctor|check [--dir <path>]
       debt absent <path> <rg arguments>...
       debt python <body>
       debt help

Asks every entry of the debt ledger whether its debt still holds.

An entry starts at a line beginning '- ' and ends before the next '- ', '## ' or the end of
the file. Its last non-empty line is the re-check line:
  re-check: `<command>`
(two spaces, then 're-check:', one space and the command in backticks). The command runs from
the repository root with sh -c and a 5 s budget: exit 0 means the debt still holds, exit 1
means the debt is gone, anything else means the command is broken. "This must be absent" is
written '.claude/skills/debt-ledger/bin/debt absent <path> <rg arguments>', never with '!', which
reads a missing path as absent. A Python re-check is written
'.claude/skills/debt-ledger/bin/debt python <body>', never by calling an interpreter, which exits
1 (gone) when the body fails to compile or raises.

Every clause of a re-check command (split on &&, ||, ;, | and a lone &, outside quotes; a
$(...) is a clause of its own) starts with an allowed tool, after 'env -C <dir>' and
'NAME=value' assignments are set aside: rg, test, [, git, jq, awk, true, false or
.claude/skills/debt-ledger/bin/debt. A clause never starts with '!'. git runs only a read-only
subcommand (ls-files, log, diff, show, rev-parse, cat-file, grep), named after any '-C <dir>'
and '-c <key=value>' options. Only these words are bounded; the other arguments of an allowed
tool are not inspected. A clause of assignments alone runs no tool and passes. doctor is a lint
against mistakes, not a sandbox.

commands:
  doctor   print 'entries N, missing M, duplicates D, malformed K', then one
           'missing: <title>' line per entry without a re-check line, one 'duplicates: <title>'
           line per title used twice and one 'malformed: <title> — <fix>' line per re-check
           line with a clause that breaks the rules above (the first one found); exit 1 when any
           count is not zero
  check    run every re-check line and print 'HOLDS', 'GONE' or 'BROKEN' with the title; exit
           0 when every entry holds, exit 1 with a count line when an entry is gone or a
           command is broken; entries without a re-check line are skipped (see doctor)
  absent   run 'rg -q <rg arguments> <path>' from the current directory; exit 0 when the path
           exists and nothing matches, 1 when something matches, 2 when the path is missing or
           rg fails
  python   compile and run <body> as Python; exit 0 or 1 when the body calls sys.exit with 0
           or 1 (or ends, or calls sys.exit(), for 0); a compile error, any other exception
           or any other exit code exits 2 with one '<Type>: <message>' line on stderr

ADR re-check lines:
  A decision in an ADR's '## Decisions' section states how to re-verify it with
  'Re-check [<kind>]:', where the kind is one of
    assert     the backticked command right after the marker, in the same decision
               bullet, exits 0 while the decision's constraint holds and 1 when it is gone
    absent     the same, with rg's polarity: a single rg clause that exits 1 (nothing
               found) while the constraint holds and 0 when something matches
    gh         needs the GitHub CLI and its login
    prod-read  needs production or cloud access
    manual     needs a person: a build, a running instance, a judgement of the output
    prose      names no command, only a source to read
  Only assert and absent lines run, under the clause rules and the 5 s budget above. Their
  command follows the marker directly and is the whole check: a second backticked span in the
  same sentence makes the line malformed, while prose that explains the result is allowed.
  A 'Re-check:' without a kind is unmarked.

adr commands:
  adr doctor  print 'lines N, assert A, absent B, gh C, prod-read D, manual E, prose F,
              unmarked U, malformed M', then one 'unmarked: <adr>:<line>' line per
              Re-check without a kind and one 'malformed: <adr>:<line> — <fix>' line per
              unknown kind or asserting line whose command breaks the rules; exit 1 when U or
              M is not zero
  adr check   run every assert and absent line and print 'PASS', 'FAIL' or 'BROKEN' with
              '<adr>:<line>' and the command, an unmarked or malformed line as 'BROKEN', then
              one 'not run <kind>:' line per other kind naming its lines; exit 1 with a count
              line when a line fails or is broken

options:
  --file <path>         read this ledger instead of docs/debt.md in the repository
  --only <substring>    check: run only the entries whose title contains the substring
  --dir <path>          adr: read the ADRs in this directory instead of docs/adr"""

RECHECK_LINE = re.compile(r"^  re-check: `([^`]+)`$")
LEDGER_CLI = ".claude/skills/debt-ledger/bin/debt"
ALLOWED_TOOLS = frozenset({"rg", "test", "[", "git", "jq", "awk", "true", "false", LEDGER_CLI})
READ_ONLY_GIT = frozenset({"ls-files", "log", "diff", "show", "rev-parse", "cat-file", "grep"})
SHELL_ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
SUBSTITUTION_MARK = "$(…)"
SENTENCE_END = re.compile(r"(?<!e\.g)(?<!i\.e)[.?!](?=\s|$)")
TIME_BUDGET = 5
ADR_MARKER = re.compile(r"(?:^|(?<=\s))Re-check(?: \[([^\]]*)\])?:")
BACKTICK_SPAN = re.compile(r"`([^`]+)`")
BULLET_CLAUSE = re.compile(r"^\s+(REJECTED|INVARIANT|NON-GOAL):")
ADR_FILE_GLOB = "[0-9][0-9][0-9]-*.md"
RUN_KINDS = ("assert", "absent")
NOT_RUN_KINDS = ("gh", "prod-read", "manual", "prose")
ADR_KINDS = RUN_KINDS + NOT_RUN_KINDS
KIND_LIST_TEXT = ", ".join(f"[{kind_name}]" for kind_name in ADR_KINDS)


@dataclass
class LedgerEntry:
    entry_title: str
    recheck_command: str | None


@dataclass
class AdrRecheck:
    line_label: str
    line_kind: str | None
    recheck_command: str | None
    lead_text: str = ""
    sentence_tail: str = ""


def stop_with(error_message, exit_code=2):
    print(f"debt: {error_message}", file=sys.stderr)
    sys.exit(exit_code)


def find_root():
    script_dir = Path(__file__).resolve().parent
    git_result = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=script_dir,
                                capture_output=True, text=True)
    if git_result.returncode != 0:
        stop_with(f"{script_dir} is not inside a git checkout; run debt from the LimbusPlanner repository or a worktree")
    return Path(git_result.stdout.strip())


def title_of(prose_lines):
    joined_text = " ".join(prose_line.strip() for prose_line in prose_lines)[2:]
    for sentence_end in SENTENCE_END.finditer(joined_text):
        if joined_text.count("`", 0, sentence_end.start()) % 2 == 0:
            return joined_text[:sentence_end.start()]
    return joined_text


def parse_ledger(ledger_text):
    ledger_entries = []
    current_lines = None

    def close_entry():
        if current_lines is None:
            return
        filled_lines = [text_line for text_line in current_lines if text_line.strip()]
        recheck_match = RECHECK_LINE.match(filled_lines[-1]) if len(filled_lines) > 1 else None
        prose_lines = filled_lines[:-1] if recheck_match else filled_lines
        ledger_entries.append(LedgerEntry(title_of(prose_lines),
                                          recheck_match.group(1) if recheck_match else None))

    for text_line in ledger_text.splitlines():
        if text_line.startswith("- ") or text_line.startswith("## "):
            close_entry()
            current_lines = [text_line] if text_line.startswith("- ") else None
        elif current_lines is not None:
            current_lines.append(text_line)
    close_entry()
    return ledger_entries


def count_of(item_count, singular_word, plural_word):
    return f"{item_count} {singular_word if item_count == 1 else plural_word}"


def run_recheck(recheck_command, repo_root):
    shell_process = subprocess.Popen(["sh", "-c", recheck_command], cwd=repo_root,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True,
                                     start_new_session=True)
    try:
        _, error_text = shell_process.communicate(timeout=TIME_BUDGET)
    except subprocess.TimeoutExpired:
        os.killpg(shell_process.pid, signal.SIGKILL)
        shell_process.communicate()
        return f"timed out after {TIME_BUDGET} s"
    if shell_process.returncode in (0, 1):
        return shell_process.returncode
    error_lines = [error_line for error_line in error_text.splitlines() if error_line.strip()]
    first_error = f" — {error_lines[0]}" if error_lines else ""
    return f"exit {shell_process.returncode}{first_error}"


def run_python(python_args):
    if len(python_args) != 1:
        stop_with("python takes one body argument; run debt python '<body>'")
    try:
        exec(compile(python_args[0], "<re-check>", "exec"), {"__name__": "__re_check__"})
    except SystemExit as exit_signal:
        exit_code = 0 if exit_signal.code is None else exit_signal.code
        if isinstance(exit_code, int) and exit_code in (0, 1):
            return exit_code
        print(f"SystemExit: {exit_signal.code}", file=sys.stderr)
        return 2
    except Exception as body_error:
        print(f"{type(body_error).__name__}: {body_error}", file=sys.stderr)
        return 2
    return 0


def is_lone_ampersand(shell_command, char_index):
    previous_char = shell_command[char_index - 1] if char_index > 0 else ""
    next_char = shell_command[char_index + 1:char_index + 2]
    return previous_char not in ("<", ">") and next_char != ">"


def split_clauses(shell_command):
    finished_clauses = []
    open_frames = [{"clause_chars": [], "quote_char": None, "paren_depth": 0}]
    char_index = 0

    def finish_clause(clause_frame):
        finished_clauses.append("".join(clause_frame["clause_chars"]))
        clause_frame["clause_chars"] = []

    while char_index < len(shell_command):
        current_frame = open_frames[-1]
        current_char = shell_command[char_index]
        if current_frame["quote_char"] == "'":
            current_frame["clause_chars"].append(current_char)
            if current_char == "'":
                current_frame["quote_char"] = None
            char_index += 1
        elif current_char == "\\":
            current_frame["clause_chars"].append(shell_command[char_index:char_index + 2])
            char_index += 2
        elif shell_command.startswith("$(", char_index):
            open_frames.append({"clause_chars": [], "quote_char": None, "paren_depth": 0})
            char_index += 2
        elif current_frame["quote_char"] == '"' or current_char in "'\"":
            current_frame["clause_chars"].append(current_char)
            if current_frame["quote_char"] == '"' and current_char == '"':
                current_frame["quote_char"] = None
            elif current_frame["quote_char"] is None:
                current_frame["quote_char"] = current_char
            char_index += 1
        elif current_char == ")" and current_frame["paren_depth"] == 0 and len(open_frames) > 1:
            finish_clause(open_frames.pop())
            open_frames[-1]["clause_chars"].append(SUBSTITUTION_MARK)
            char_index += 1
        elif shell_command.startswith(("&&", "||"), char_index):
            finish_clause(current_frame)
            char_index += 2
        elif current_char in ";|" or (current_char == "&" and is_lone_ampersand(shell_command, char_index)):
            finish_clause(current_frame)
            char_index += 1
        else:
            if current_char == "(":
                current_frame["paren_depth"] += 1
            elif current_char == ")":
                current_frame["paren_depth"] -= 1
            current_frame["clause_chars"].append(current_char)
            char_index += 1
    for remaining_frame in open_frames:
        finish_clause(remaining_frame)
    return finished_clauses


def git_subcommand(git_args):
    arg_index = 0
    while arg_index < len(git_args) and git_args[arg_index] in ("-C", "-c"):
        arg_index += 2
    return git_args[arg_index] if arg_index < len(git_args) else ""


def clause_problem(clause_text):
    clause_words = clause_text.split()
    if clause_words[:1] == ["!"]:
        return "negates a clause; use debt absent"
    if clause_words[:2] == ["env", "-C"]:
        clause_words = clause_words[3:]
    while clause_words and SHELL_ASSIGNMENT.match(clause_words[0]):
        clause_words = clause_words[1:]
    if not clause_words:
        return None
    if clause_words[0] not in ALLOWED_TOOLS:
        return (f'starts a clause with "{clause_words[0]}", which is not an allowed re-check tool; '
                f'see debt help')
    if clause_words[0] == "git":
        git_word = git_subcommand(clause_words[1:])
        if git_word not in READ_ONLY_GIT:
            return f'runs git "{git_word}", which is not a read-only git subcommand; see debt help'
    return None


def command_problem(shell_command):
    for clause_text in split_clauses(shell_command):
        problem_text = clause_problem(clause_text)
        if problem_text is not None:
            return problem_text
    return None


def run_doctor(ledger_entries):
    title_counts = {}
    for ledger_entry in ledger_entries:
        title_counts[ledger_entry.entry_title] = title_counts.get(ledger_entry.entry_title, 0) + 1
    missing_titles = [ledger_entry.entry_title for ledger_entry in ledger_entries
                      if ledger_entry.recheck_command is None]
    duplicate_titles = [entry_title for entry_title, title_count in title_counts.items()
                        if title_count > 1]
    malformed_lines = []
    for ledger_entry in ledger_entries:
        if ledger_entry.recheck_command is None:
            continue
        problem_text = command_problem(ledger_entry.recheck_command)
        if problem_text is not None:
            malformed_lines.append(f"{ledger_entry.entry_title} — {problem_text}")
    print(f"entries {len(ledger_entries)}, missing {len(missing_titles)}, "
          f"duplicates {len(duplicate_titles)}, malformed {len(malformed_lines)}")
    for entry_title in missing_titles:
        print(f"missing: {entry_title}")
    for entry_title in duplicate_titles:
        print(f"duplicates: {entry_title}")
    for malformed_line in malformed_lines:
        print(f"malformed: {malformed_line}")
    return 1 if missing_titles or duplicate_titles or malformed_lines else 0


def run_absent(absent_args):
    if len(absent_args) < 2:
        stop_with("absent needs a path and an rg pattern; run debt absent <path> <rg arguments>")
    search_path, rg_args = absent_args[0], absent_args[1:]
    if not os.path.exists(search_path):
        stop_with(f"{search_path} does not exist; point the re-check at the path that holds the code")
    try:
        rg_result = subprocess.run(["rg", "-q", *rg_args, search_path])
    except FileNotFoundError:
        stop_with("rg is not on PATH; install ripgrep")
    if rg_result.returncode == 0:
        return 1
    if rg_result.returncode == 1:
        return 0
    return 2


def run_check(ledger_entries, only_text, repo_root):
    checked_entries = [ledger_entry for ledger_entry in ledger_entries
                       if ledger_entry.recheck_command is not None]
    if only_text is not None:
        checked_entries = [ledger_entry for ledger_entry in checked_entries
                           if only_text in ledger_entry.entry_title]
        if not checked_entries:
            stop_with(f"no entry matches {only_text}; run debt check without --only to list every title")
    gone_count = broken_count = 0
    for ledger_entry in checked_entries:
        entry_verdict = run_recheck(ledger_entry.recheck_command, repo_root)
        if entry_verdict == 0:
            print(f"HOLDS {ledger_entry.entry_title}")
        elif entry_verdict == 1:
            gone_count += 1
            print(f"GONE {ledger_entry.entry_title}")
        else:
            broken_count += 1
            print(f"BROKEN {ledger_entry.entry_title}: {entry_verdict}")
    if gone_count or broken_count:
        print(f"{count_of(gone_count, 'entry', 'entries')} to delete, "
              f"{count_of(broken_count, 'command', 'commands')} to fix")
        return 1
    return 0


def parse_adr(adr_number, adr_text):
    adr_rechecks = []
    in_decisions = False
    text_lines = adr_text.splitlines()
    for line_index, text_line in enumerate(text_lines):
        line_number = line_index + 1
        if text_line.startswith("## "):
            in_decisions = text_line.startswith("## Decisions")
            continue
        if not in_decisions:
            continue
        continuation_lines = []
        for next_line in text_lines[line_index + 1:]:
            if not next_line.startswith(" ") or BULLET_CLAUSE.match(next_line):
                break
            continuation_lines.append(next_line.strip())
        for marker_match in ADR_MARKER.finditer(text_line):
            following_text = " ".join([text_line[marker_match.end():], *continuation_lines])
            command_match = BACKTICK_SPAN.search(following_text)
            if command_match is None:
                adr_rechecks.append(AdrRecheck(f"{adr_number}:{line_number}", marker_match.group(1), None))
                continue
            adr_rechecks.append(AdrRecheck(f"{adr_number}:{line_number}", marker_match.group(1),
                                           command_match.group(1),
                                           following_text[:command_match.start()].strip(),
                                           sentence_rest(following_text[command_match.end():])))
    return adr_rechecks


def sentence_rest(tail_text):
    for sentence_end in SENTENCE_END.finditer(tail_text):
        if tail_text.count("`", 0, sentence_end.start()) % 2 == 0:
            return tail_text[:sentence_end.start()]
    return tail_text


def read_adrs(adr_dir):
    adr_rechecks = []
    for adr_file in sorted(adr_dir.glob(ADR_FILE_GLOB)):
        adr_rechecks.extend(parse_adr(adr_file.name[:3], adr_file.read_text(encoding="utf-8")))
    return adr_rechecks


def adr_problem(adr_recheck):
    if adr_recheck.line_kind is None:
        return f"unmarked; add one of {KIND_LIST_TEXT} after Re-check"
    if adr_recheck.line_kind not in ADR_KINDS:
        return f'kind "[{adr_recheck.line_kind}]" is not one of {KIND_LIST_TEXT}'
    if adr_recheck.line_kind not in RUN_KINDS:
        return None
    if adr_recheck.recheck_command is None:
        return "names no backticked command after the marker; mark it [manual] or [prose]"
    if adr_recheck.lead_text or BACKTICK_SPAN.search(adr_recheck.sentence_tail):
        return "states more than its command checks; mark it [manual] or make the command the whole check"
    problem_text = command_problem(adr_recheck.recheck_command)
    if problem_text is not None:
        return f"{problem_text}, or mark it [manual]"
    if adr_recheck.line_kind == "absent":
        command_clauses = split_clauses(adr_recheck.recheck_command)
        if len(command_clauses) != 1 or command_clauses[0].split()[:1] != ["rg"]:
            return "an [absent] line runs one rg clause; mark it [assert] or [manual]"
    return None


def adr_verdict(line_kind, run_result):
    if isinstance(run_result, str):
        return "BROKEN"
    holds_code = 0 if line_kind == "assert" else 1
    return "PASS" if run_result == holds_code else "FAIL"


def run_adr_doctor(adr_rechecks):
    kind_counts = {kind_name: 0 for kind_name in ADR_KINDS}
    unmarked_labels = []
    malformed_lines = []
    for adr_recheck in adr_rechecks:
        problem_text = adr_problem(adr_recheck)
        if adr_recheck.line_kind is None:
            unmarked_labels.append(adr_recheck.line_label)
        elif problem_text is not None:
            malformed_lines.append(f"{adr_recheck.line_label} — {problem_text}")
        if adr_recheck.line_kind in kind_counts:
            kind_counts[adr_recheck.line_kind] += 1
    count_text = ", ".join(f"{kind_name} {kind_count}" for kind_name, kind_count in kind_counts.items())
    print(f"lines {len(adr_rechecks)}, {count_text}, "
          f"unmarked {len(unmarked_labels)}, malformed {len(malformed_lines)}")
    for line_label in unmarked_labels:
        print(f"unmarked: {line_label}")
    for malformed_line in malformed_lines:
        print(f"malformed: {malformed_line}")
    return 1 if unmarked_labels or malformed_lines else 0


def run_adr_check(adr_rechecks, repo_root):
    fail_count = broken_count = 0
    not_run_labels = {kind_name: [] for kind_name in NOT_RUN_KINDS}
    for adr_recheck in adr_rechecks:
        problem_text = adr_problem(adr_recheck)
        if problem_text is not None:
            broken_count += 1
            print(f"BROKEN {adr_recheck.line_label}: {problem_text}")
            continue
        if adr_recheck.line_kind in not_run_labels:
            not_run_labels[adr_recheck.line_kind].append(adr_recheck.line_label)
            continue
        run_result = run_recheck(adr_recheck.recheck_command, repo_root)
        line_verdict = adr_verdict(adr_recheck.line_kind, run_result)
        if line_verdict == "BROKEN":
            broken_count += 1
            print(f"BROKEN {adr_recheck.line_label}: {run_result} — {adr_recheck.recheck_command}")
        else:
            fail_count += line_verdict == "FAIL"
            print(f"{line_verdict} {adr_recheck.line_label} {adr_recheck.recheck_command}")
    for kind_name, line_labels in not_run_labels.items():
        if line_labels:
            print(f"not run {kind_name}: {', '.join(line_labels)}")
    if fail_count or broken_count:
        print(f"{count_of(fail_count, 'line', 'lines')} failed, "
              f"{count_of(broken_count, 'line', 'lines')} broken")
        return 1
    return 0


def run_adr(adr_args):
    if not adr_args or adr_args[0] not in ("doctor", "check"):
        stop_with("adr takes doctor or check; run debt adr doctor or debt adr check")
    command_name, option_args = adr_args[0], adr_args[1:]
    adr_dir = None
    while option_args:
        option_arg = option_args.pop(0)
        if option_arg != "--dir":
            stop_with(f"unknown argument '{option_arg}' after adr {command_name}; see debt help")
        if not option_args:
            stop_with("--dir needs a value; run debt adr check --dir <path>")
        adr_dir = Path(option_args.pop(0))
    repo_root = find_root()
    adr_dir = adr_dir or repo_root / "docs" / "adr"
    if not adr_dir.is_dir():
        stop_with(f"no ADR directory at {adr_dir}; pass --dir <path> to a directory of NNN-title.md files")
    adr_rechecks = read_adrs(adr_dir)
    if command_name == "doctor":
        return run_adr_doctor(adr_rechecks)
    return run_adr_check(adr_rechecks, repo_root)


def main():
    for git_variable in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_COMMON_DIR"):
        os.environ.pop(git_variable, None)
    arg_list = sys.argv[1:]
    command_name = ledger_path = only_text = None
    while arg_list:
        current_arg = arg_list.pop(0)
        if current_arg == "help" and command_name is None:
            print(USAGE_TEXT)
            return 0
        if current_arg in ("-h", "--help"):
            stop_with(f"{current_arg} is not an option; run debt help")
        if current_arg in ("--file", "--only"):
            if not arg_list:
                stop_with(f"{current_arg} needs a value; see debt help")
            if current_arg == "--file":
                ledger_path = Path(arg_list.pop(0))
            else:
                only_text = arg_list.pop(0)
        elif current_arg == "adr":
            if command_name is not None or ledger_path is not None or only_text is not None:
                stop_with("adr takes no ledger command or option; run debt adr check")
            return run_adr(arg_list)
        elif current_arg == "absent":
            if command_name is not None or ledger_path is not None or only_text is not None:
                stop_with("absent takes no other command or option; run debt absent <path> <rg arguments>")
            return run_absent(arg_list)
        elif current_arg == "python":
            if command_name is not None or ledger_path is not None or only_text is not None:
                stop_with("python takes no other command or option; run debt python '<body>'")
            return run_python(arg_list)
        elif current_arg in ("doctor", "check"):
            if command_name is not None:
                stop_with("one command at a time; see debt help")
            command_name = current_arg
        else:
            stop_with(f"unknown argument '{current_arg}'; see debt help")
    if command_name is None:
        stop_with("name a command, doctor, check, adr, absent or python; see debt help")
    if only_text is not None and command_name != "check":
        stop_with("--only works with check alone; run debt check --only <substring>")
    repo_root = find_root()
    ledger_path = ledger_path or repo_root / "docs" / "debt.md"
    if not ledger_path.is_file():
        stop_with(f"no ledger at {ledger_path}; pass --file <path> to a debt ledger")
    ledger_entries = parse_ledger(ledger_path.read_text(encoding="utf-8"))
    if command_name == "doctor":
        return run_doctor(ledger_entries)
    return run_check(ledger_entries, only_text, repo_root)


if __name__ == "__main__":
    sys.exit(main())
