#!/usr/bin/env python3
import datetime
import importlib
import os
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
paths = importlib.import_module("opscli.paths")
redaction = importlib.import_module("opscli.redaction")


def main(argv_words, system_effects=None, caller_dir=None, run_moment=None, repo_paths=None):
    with redaction.redacted_streams():
        if list(argv_words) == ["hook"]:
            return importlib.import_module("opscli.hook").hook_main(sys.stdin.read())
        return run_command(argv_words, system_effects, caller_dir or os.getcwd(), run_moment, repo_paths)


def run_command(argv_words, system_effects, caller_dir, run_moment, repo_paths):
    commands = importlib.import_module("opscli.commands")
    ops_request = commands.parse_request(argv_words)
    command_name = ops_request.command_words[0] if ops_request.command_words else ""
    if ops_request.wants_help or not command_name:
        print(commands.USAGE_TEXT, end="", file=sys.stdout if ops_request.wants_help else sys.stderr)
        return 0 if ops_request.wants_help else 2
    if command_name == "hook":
        return importlib.import_module("opscli.hook").hook_main(sys.stdin.read())
    if command_name == "list":
        print("\n".join(commands.list_lines()))
        return 0
    session = importlib.import_module("opscli.session")
    system_effects = system_effects or session.SystemEffects()
    repo_paths = repo_paths or paths.find_repo_paths(paths.own_checkout_dir())
    if command_name == "doctor":
        return session.run_doctor(repo_paths, system_effects)
    run_moment = run_moment or datetime.datetime.now()
    terraform = importlib.import_module("opscli.terraform")
    if command_name == "tf":
        return terraform.run_tf(repo_paths, ops_request, system_effects, caller_dir, run_moment)
    script_invocation = commands.build_invocation(ops_request.command_words, caller_dir)
    terraform.require_site_init(repo_paths.repo_root, script_invocation, ops_request.env_name)
    return commands.run_invocation(repo_paths, script_invocation, ops_request.env_name, system_effects, run_moment)


if __name__ == "__main__":
    with redaction.redacted_streams():
        try:
            exit_code = main(sys.argv[1:])
        except paths.OpsError as ops_error:
            print(f"ops: {ops_error}", file=sys.stderr)
            exit_code = 2
        except KeyboardInterrupt:
            exit_code = 130
    sys.exit(exit_code)
