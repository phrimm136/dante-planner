# Copy to terraform.tfvars (gitignored) and fill in. Never commit the real file — it carries
# account-specific identifiers.

# --- Required ---------------------------------------------------------------

# The account this stack may apply into; a plan resolving to any other account fails.
aws_account_id = "REPLACE_WITH_ACCOUNT_ID"

# The RDS (prod) VPC to peer with, in the PRIMARY region. Cross-region peering, so terraform/rds
# must carry the matching return route and 3306 ingress for seoul_fleet_cidr — a CIDR rule,
# because a security-group reference cannot cross regions.
rds_vpc_id = "vpc-REPLACE_WITH_RDS_VPC_ID"

# CIDRs allowed to reach the ingress node on 443. Production value = Cloudflare edge ranges only
# (https://www.cloudflare.com/ips/). The mTLS Authenticated Origin Pull at the origin is the real
# gate; this SG is defense-in-depth.
ingress_allowed_cidrs = ["REPLACE_WITH_CLOUDFLARE_CIDRS"]

# --- Optional overrides (defaults in variables.tf are sensible) --------------

# region      = "ap-northeast-2"
# rds_region  = "us-west-2"
# vpc_cidr    = "10.30.0.0/16"   # must not overlap Oregon's 10.20.0.0/16 or the RDS VPC
# name_prefix = "danteplanner"

# Empty (the default) means this fleet pulls images from its own account's registry. Set it to the
# account that owns the ECR repositories when they live elsewhere.
# backend_ecr_account_id = "REPLACE_WITH_ACCOUNT_ID"

# The git ref this region's ArgoCD syncs, and the value that decides which code the fleet runs.
# MUST match Oregon's gitops_target_revision: a mismatch deploys a different revision per region
# and nothing reports it. A branch tip is resolved but not immutable; pin a SHA or tag for a
# boot-time-reproducible control plane.
# gitops_target_revision = "main"
