# Copy to terraform.tfvars (gitignored) and fill in. Three values are required; the rest have
# sensible defaults in variables.tf. Do not commit the real file — it carries account-specific ids.

# REQUIRED: the account this stack may apply into.
aws_account_id = "000000000000"

# REQUIRED: the RDS (prod) VPC id to peer with, in the PRIMARY region. Cross-region peering, so
# terraform/rds must carry the matching return route and 3306 ingress for seoul_fleet_cidr —
# a CIDR rule, because a security-group reference cannot cross regions.
rds_vpc_id = "vpc-REPLACE_WITH_RDS_VPC_ID"

# REQUIRED: CIDRs allowed to reach the ingress node on 443. Production value = Cloudflare edge
# ranges only (https://www.cloudflare.com/ips/). The mTLS Authenticated Origin Pull at the origin
# is the real gate; this SG is defense-in-depth.
ingress_allowed_cidrs = ["REPLACE_WITH_CLOUDFLARE_CIDRS"]

# Optional overrides:
# region      = "ap-northeast-2"
# rds_region  = "us-west-2"
# vpc_cidr    = "10.30.0.0/16"   # must not overlap Oregon's 10.20.0.0/16 or the RDS VPC
# name_prefix = "danteplanner"
