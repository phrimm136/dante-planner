# Copy to <account>.tfvars (gitignored) and fill in — one file per account, passed explicitly
# beside that account's backend file:
#
#   scripts/ops/terraform-run.sh -chdir=terraform/state-backend init -reconfigure -backend-config=../backend.<account>.hcl
#   scripts/ops/terraform-run.sh -chdir=terraform/state-backend plan -var-file=<account>.tfvars
#
# A new account's first apply has no bucket to init against: it runs on local state (see
# versions.tf), by hand through the runner rather than ops, which has no profile for that account
# yet, and scripts/ops/provision/bootstrap-state-to-s3.sh moves the state into the new bucket
# right after.
#
# NOT terraform.tfvars: that name auto-loads on every invocation, including ones passing a
# different -var-file, so one account silently inherits another's values.
#
# Never commit the real file; it carries account-specific identifiers.

# --- Required ---------------------------------------------------------------

# The account this stack may apply into; a plan resolving to any other account fails.
aws_account_id = "REPLACE_WITH_ACCOUNT_ID"

# --- Optional overrides (defaults in variables.tf are sensible) --------------

# Role to assume in the target account. Leave unset when the credentials already belong there.
# Reaching a member account from the management account uses the role each account is created with.
# assume_role_arn = "arn:aws:iam::REPLACE_WITH_ACCOUNT_ID:role/OrganizationAccountAccessRole"

# region      = "us-west-2"
# name_prefix = "danteplanner"      # changing this orphans an existing bucket, it does not rename one
