# Copy to <environment>.tfvars (gitignored) and fill in, then pass it explicitly:
#   terraform -chdir=terraform/rds plan -var-file=prod.tfvars
#
# NOT terraform.tfvars: that name auto-loads on every invocation, including ones passing a
# different -var-file, so one environment silently inherits another's values.
#
# Never commit the real file — it carries account-specific identifiers.

# --- Required ---------------------------------------------------------------

# The account this stack may apply into; a plan resolving to any other account fails.
aws_account_id = "REPLACE_WITH_ACCOUNT_ID"

# The VPC and subnets RDS lives in. Neither is managed by any stack in this repo — see
# terraform/README.md, "What must already exist". Subnets must span >= 2 AZs.
vpc_id        = "vpc-REPLACE_WITH_RDS_VPC_ID"
db_subnet_ids = ["subnet-REPLACE_WITH_SUBNET_A", "subnet-REPLACE_WITH_SUBNET_B"]

# Pin to >= the source's @@version (runbook 0.2). A coarse "8.0" would let AWS pick a minor BELOW
# the source, which stalls replication silently; the variable's validation rejects it.
engine_version = "8.0.40"

# The master password is NOT set here. It is read at plan time from Secrets Manager; seed the entry
# once with scripts/ops/provision/rds-master-password-secret.sh, then apply terraform/secrets so
# the container replicates to Seoul.

# --- Optional overrides (defaults in variables.tf are sensible) --------------

# master_password_secret_name = "danteplanner/rds/master-password"
# instance_class              = "db.t4g.micro"
# ca_cert_identifier          = "rds-ca-rsa2048-g1"  # match the live instance's current CA
# db_name                     = "danteplanner"

# Set to the source's captured @@sql_mode (runbook 0.2) before applying:
# sql_mode = "..."

# Oregon fleet <-> RDS VPC peering. Set AFTER terraform/oregon apply, from its outputs
# `rds_peering_connection_id` and `cluster_security_group_id`. Leave unset for a plain RDS apply —
# the peering resources are guarded off until all three are set.
# fleet_peering_connection_id     = "pcx-REPLACE_WITH_PEERING_ID"
# fleet_cluster_security_group_id = "sg-REPLACE_WITH_SG_ID"
# fleet_vpc_cidr                  = "10.20.0.0/16"

# Seoul fleet -> RDS return path. Set AFTER terraform/seoul apply, from its module.fleet output
# `rds_peering_connection_id`. The 3306 ingress is CIDR-based here because a security-group
# reference cannot cross regions.
# seoul_peering_connection_id = "pcx-REPLACE_WITH_PEERING_ID"
# seoul_fleet_cidr            = "10.30.0.0/16"
