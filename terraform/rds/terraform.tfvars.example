# Copy to terraform.tfvars (gitignored) and fill with YOUR account's real values.
# Do NOT commit terraform.tfvars — it carries account-specific identifiers and a password.

# REQUIRED: the account this stack may apply into.
aws_account_id        = "000000000000"

vpc_id                = "vpc-xxxxxxxxxxxxxxxxx"
db_subnet_ids         = ["subnet-aaaaaaaaaaaaaaaaa", "subnet-bbbbbbbbbbbbbbbbb"] # >=2 AZs
engine_version        = "8.0.40"       # REQUIRED: pin to >= source @@version (runbook 0.2)
# availability_zone is rejected alongside multi_az.

# The master password is NOT set here. It is read at plan time from Secrets Manager; seed the
# entry once with scripts/ops/provision/rds-master-password-secret.sh, then apply
# terraform/secrets so the container replicates to Seoul.

# Optional overrides (defaults are sensible):
# master_password_secret_name = "danteplanner/rds/master-password"
# instance_class     = "db.t4g.micro"
# ca_cert_identifier = "rds-ca-rsa2048-g1"  # set to the live instance's current CA
# db_name            = "danteplanner"

# Set this to the source's captured @@sql_mode (runbook step 0.2) before applying:
# sql_mode = "..."

# Oregon fleet <-> RDS VPC peering (set AFTER terraform/oregon apply, from its outputs
# `rds_peering_connection_id` and `cluster_security_group_id`). Leave unset for a
# plain RDS apply — the peering resources are guarded off until all three are set.
# fleet_peering_connection_id     = "pcx-..."
# fleet_cluster_security_group_id = "sg-..."
# fleet_vpc_cidr                  = "10.20.0.0/16"

# Seoul fleet -> RDS return path (set AFTER terraform/seoul apply, from its module.fleet
# output `rds_peering_connection_id`). The 3306 ingress is CIDR-based here because a
# security-group reference cannot cross regions.
# seoul_peering_connection_id = "pcx-..."
# seoul_fleet_cidr            = "10.30.0.0/16"
