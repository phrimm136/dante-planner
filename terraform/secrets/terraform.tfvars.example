# Copy to terraform.tfvars (gitignored) and fill in. Never commit the real file — it carries
# account-specific identifiers.

# --- Required ---------------------------------------------------------------

# The account this stack may apply into; a plan resolving to any other account fails.
aws_account_id = "REPLACE_WITH_ACCOUNT_ID"

# --- Optional overrides (defaults in variables.tf are sensible) --------------

# region         = "us-west-2"
# replica_region = "ap-northeast-2"

# secret_names defaults to the full enrolled set. Override only to apply a subset — every name
# listed must already exist, because this stack adopts containers with import blocks rather than
# creating them. Values are provisioned by scripts/ops/provision/*.sh.
# secret_names = ["danteplanner/jwt/rs256-private-key"]

# origin_client_ca: the Cloudflare Authenticated Origin Pull CA (PEM). Public, not secret, so it is
# safe here. Empty (the default) creates nothing; set it only when restoring the Traefik TLSOption.
# origin_client_ca = <<-EOT
#   -----BEGIN CERTIFICATE-----
#   ...
#   -----END CERTIFICATE-----
# EOT
