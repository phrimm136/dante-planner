# Copy to terraform.tfvars (gitignored) and fill in. Three values are required —
# aws_account_id, ingress_allowed_cidrs, rds_vpc_id; the rest have sensible
# defaults in variables.tf.

# REQUIRED: the account this stack may apply into.
aws_account_id = "000000000000"

# REQUIRED: CIDRs allowed to reach the ingress node on 443.
# Production value = Cloudflare edge ranges only (https://www.cloudflare.com/ips/).
# Requests arrive through a Cloudflare Tunnel, which dials outward, so this SG guards a
# path nothing normally uses; keep it narrow anyway. A single /32 of your own IP is enough
# for an initial single-region smoke test.
ingress_allowed_cidrs = ["REPLACE_WITH_CLOUDFLARE_CIDRS"]

# REQUIRED: the RDS (prod) VPC id to peer with for private DB access. Its CIDR
# must not overlap vpc_cidr (10.20.0.0/16). Do not commit the real value.
rds_vpc_id = "vpc-REPLACE_WITH_RDS_VPC_ID"

# Peer-region fleet CIDR admitted to the auth Redis NodePort over VPC peering, so the Seoul
# replica can REPLICAOF and Seoul pods can write blacklist/rotation/tombstone state. Empty
# (the default) creates NO rule and keeps the auth Redis region-private. This store holds
# revocation state: set the one peer fleet CIDR, never a broad range.
# redis_cross_region_cidr = "10.30.0.0/16"

# Optional overrides (defaults are sensible):
# region                        = "us-west-2"
# vpc_cidr                      = "10.20.0.0/16"
# availability_zones            = ["us-west-2a", "us-west-2b"]
# instance_type                 = "t4g.small"
# ssh_key_name                  = ""            # break-glass EC2 key; empty = SSM only
# app_asg_min_size              = 1
# app_asg_desired_capacity      = 1
# app_asg_max_size              = 2
# backend_image_repo            = "danteplanner-backend"
# backend_ecr_account_id        = ""            # empty = this account's registry
# rs256_private_key_secret_name = "danteplanner/jwt/rs256-private-key"
# gitops_repo_url               = "https://github.com/phrimm136/dante-planner.git"
# gitops_target_revision        = "main"        # the git ref ArgoCD syncs
# argocd_version                = "v2.13.2"
# billing_alarm_threshold       = 200
# alarm_sns_topic_arn           = ""            # SNS topic for notifications; empty = none
# etcd_snapshot_retention       = 5
