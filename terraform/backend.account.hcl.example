# Backend config for the <ACCOUNT> account. Pass it directly; never copy it to backend.hcl.
#
# One file per ACCOUNT, serving every stack in it: state lives in the account whose resources it
# describes, so each account has its own bucket. Each stack's key, region, workspace prefix and
# locking are literals in its own `backend "s3"` block; only what varies by account lives here.
#
# The name is `<name_prefix>-tfstate-<account_id>`; read it from the stack that creates it:
#   terraform -chdir=terraform/state-backend output -raw tf_state_bucket
#
# A backend resolves credentials independently of the provider, so reaching another account needs
# assume_role HERE too — the provider's is not consulted, and init fails as whoever is ambient:
#   assume_role = { role_arn = "arn:aws:iam::<account>:role/<role>" }
#
# The file name states the account, so the command that initializes a stack shows which
# account it acts on:
#   terraform -chdir=terraform/<stack> init -backend-config=../backend.<account>.hcl

bucket = "danteplanner-tfstate-111122223333"
