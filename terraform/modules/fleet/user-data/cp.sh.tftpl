#!/bin/bash
set -euxo pipefail

${boot_lib}
command -v aws >/dev/null 2>&1 || retry install_awscli
command -v git >/dev/null 2>&1 || retry dnf install -y git

# 1 GiB swap as an overload valve: without swap, memory exhaustion evicts
# executable pages and the host thrashes alive (apiserver and SSM stall but the
# OOM killer never fires). Low swappiness keeps swap out of the steady-state
# working set. dd, not fallocate — swapon rejects fallocated files on XFS.
dd if=/dev/zero of=/swapfile bs=1M count=1024
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
echo '/swapfile none swap sw 0 0' >> /etc/fstab
echo 'vm.swappiness = 10' > /etc/sysctl.d/90-swappiness.conf
sysctl --system

# CP private IP (IMDSv2 — IMDSv1 is disabled). Used as a k3s API cert SAN and in
# the published kubeconfig so operators reach the API in-VPC without SSH. The CP
# cannot get this from Terraform (self-reference in its own user_data = cycle).
IMDS_TOKEN=$(retry curl -sSf -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')
CP_PRIVATE_IP=$(retry curl -sSf -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4)

umask 077
fetch_token() {
  aws ssm get-parameter --with-decryption --region ${region} \
    --name "${token_param}" --query 'Parameter.Value' --output text > /etc/k3s-token
}
retry fetch_token

# Soft-cap the k3s server Go heap (apiserver, etcd, scheduler, controllers in
# one process — the node's dominant memory consumer). Near the cap the GC
# collects harder instead of letting the heap grow into host memory exhaustion.
# Written before the install so the installer's own service start picks it up.
mkdir -p /etc/systemd/system/k3s.service.d
cat > /etc/systemd/system/k3s.service.d/gomemlimit.conf <<'EOF'
[Service]
Environment=GOMEMLIMIT=800MiB
EOF

# etcd-s3 uses the CP instance-profile credentials.
mkdir -p /etc/rancher/k3s
cat > /etc/rancher/k3s/config.yaml <<'K3SCONFIG'
etcd-s3: true
etcd-s3-bucket: "${s3_bucket}"
etcd-s3-region: "${region}"
etcd-snapshot-schedule-cron: "0 */${snapshot_hours} * * *"
etcd-snapshot-retention: ${snapshot_retention}
K3SCONFIG

# k3s server with EMBEDDED etcd (--cluster-init) so etcd snapshots exist and
# ship to S3. SQLite default has no etcd and cannot snapshot. Bundled Traefik
# and servicelb are disabled: Traefik is deployed from deploy/chart on the
# ingress node with Gateway API.
retry curl -sSfL -o /root/k3s-install.sh https://get.k3s.io
# Forced: a second run that finds unchanged files skips the service start and exits 0.
install_k3s() {
  INSTALL_K3S_VERSION="${k3s_version}" INSTALL_K3S_FORCE_RESTART=true INSTALL_K3S_EXEC="server \
  --cluster-init \
  --token-file /etc/k3s-token \
  --tls-san $CP_PRIVATE_IP \
  --disable traefik \
  --disable servicelb \
  --node-taint node-role.kubernetes.io/control-plane=true:NoSchedule \
  --etcd-expose-metrics=true" sh /root/k3s-install.sh
}
retry install_k3s

export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
until kubectl get nodes >/dev/null 2>&1; do sleep 5; done

# Publish the admin kubeconfig to SSM (loopback rewritten to the CP private IP,
# a cert SAN via --tls-san) so operators fetch cluster access without SSH.
# set +x so the embedded client key never lands in the cloud-init log.
set +x
retry aws ssm put-parameter --region ${region} --name "${kubeconfig_param}" \
  --type SecureString --tier Intelligent-Tiering --overwrite \
  --value "$(sed 's#https://127.0.0.1:6443#https://'"$CP_PRIVATE_IP"':6443#' /etc/rancher/k3s/k3s.yaml)"
set -x

# ArgoCD core per cluster (reconciler only, no API server / UI — hub-spoke
# rejected, no cross-region deploy dependency).
kubectl create namespace argocd --dry-run=client -o yaml | kubectl apply -f -
retry kubectl apply -n argocd \
  -f https://raw.githubusercontent.com/argoproj/argo-cd/${argocd_version}/manifests/core-install.yaml

# The chart references no submodules (static/data is baked into the backend
# image at build time, not delivered via GitOps). Disable submodule fetch so the
# private SSH-only static submodule cannot fail manifest generation for a repo
# ArgoCD otherwise reaches over public HTTPS.
kubectl -n argocd set env deployment/argocd-repo-server ARGOCD_GIT_MODULES_ENABLED=false

# ArgoCD runs on the data node, not the CP: the CP cannot absorb ArgoCD's
# working set on top of the k3s server during node-join bursts. Pods stay
# Pending until the data node joins (same pattern as ESO on role=app below).
# The null keys strip the control-plane pin from any object that still carries
# it, so the patch is idempotent when re-applied to an already-pinned cluster.
kubectl -n argocd get deploy,statefulset -o name | while read -r obj; do
  kubectl -n argocd patch "$obj" --type merge -p '{"spec":{"template":{"spec":{"nodeSelector":{"node-role.kubernetes.io/control-plane":null,"role":"data"},"tolerations":null}}}}'
done
# No ApplicationSet resources exist in this fleet; the controller is idle load.
kubectl -n argocd scale deploy argocd-applicationset-controller --replicas=0
kubectl -n argocd rollout status deploy/argocd-repo-server --timeout=60s || true

# Platform CRDs/controllers the chart's custom resources depend on. k3s ships
# no Gateway API CRDs and --disable traefik removed the bundled path, so the CP
# installs them before ArgoCD syncs the chart (the API server rejects a CR
# whose CRD is absent). Without this the unattended rebuild cannot converge.
retry kubectl apply -f \
  https://github.com/kubernetes-sigs/gateway-api/releases/download/${gateway_api_version}/standard-install.yaml

# Traefik's OWN CRDs (traefik.io/v1alpha1) — needed for the mTLS TLSOption that
# enforces Cloudflare Authenticated Origin Pull. --disable traefik removed the
# bundled path, and deploy/chart ships only Gateway API resources, so these
# CRDs must be installed here or a TLSOption fails the whole ArgoCD sync. Pinned to
# the Traefik minor running in the chart (traefik:v3.1).
retry kubectl apply -f \
  https://raw.githubusercontent.com/traefik/traefik/${traefik_version}/docs/content/reference/dynamic-configuration/kubernetes-crd-definition-v1.yml

# External Secrets Operator (CRDs + controller), pinned to role=app nodes so its
# AWS SDK default-chain credential resolves to the app node instance profile —
# the role granted secretsmanager:GetSecretValue (no-IRSA boundary). App nodes
# may still be joining; ESO stays Pending until one is Ready, then schedules.
retry curl -sSfL -o /root/get-helm-3 https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3
retry bash /root/get-helm-3
retry helm repo add external-secrets https://charts.external-secrets.io
retry helm repo update
retry helm upgrade --install external-secrets external-secrets/external-secrets \
  --namespace external-secrets --create-namespace \
  --version ${eso_chart_version} \
  --set installCRDs=true \
  --set nodeSelector.role=app \
  --set webhook.nodeSelector.role=app \
  --set certController.nodeSelector.role=app

# Expose three platform controllers to Prometheus role:pod discovery by writing
# scrape annotations onto the POD TEMPLATE (spec.template.metadata.annotations),
# not the workload object — role:pod reads pod annotations. Each carries a
# distinct job label; the merge patch SETS every key, overriding any bundled
# annotation (k3s CoreDNS ships prometheus.io/* that would otherwise mislabel it).
# The installer is shared with the State Manager association (ssm-annotate.tf),
# which delivers it to instances that predate this bootstrap.
${install_scrape_annotate}
/usr/local/bin/scrape-annotate.sh

# App-of-apps: apply the root Application, which points ArgoCD at deploy/chart
# with the region's values file so the cluster is GitOps-managed from here on. gitops_revision may be a
# branch, tag, or commit SHA — a full clone + explicit checkout resolves any of
# them (the old `--depth 1 --branch` only took branches). Fetch is retried and
# guarded on the root-app manifest: a shallow branch clone at boot could capture
# a tree predating the manifest, and `set -e` then aborted the boot on a cryptic
# "path does not exist". Pin gitops_revision to a SHA/tag for a boot-time-
# reproducible control plane; a branch tip is still resolved but not immutable.
fetch_gitops() {
  rm -rf /opt/gitops
  git clone ${gitops_repo_url} /opt/gitops || return 1
  git -C /opt/gitops checkout ${gitops_revision} || return 1
  test -f /opt/gitops/deploy/argocd/root-app-${region_suffix}.yaml
}
retry fetch_gitops
kubectl apply -f /opt/gitops/deploy/argocd/project.yaml
kubectl apply -f /opt/gitops/deploy/argocd/root-app-${region_suffix}.yaml

# Inject the ECR registry host (account id) as the Helm parameter
# image.repository at sync time. The host is never committed to git — it is
# rendered here from Terraform state. The parameter sets only the repository, so
# the git-committed image.tag, which CI bumps, still selects the image.
kubectl -n argocd patch application danteplanner-${region_suffix} --type merge -p '{"spec":{"source":{"targetRevision":"${gitops_revision}","helm":{"parameters":[{"name":"image.repository","value":"${image_repository}"}]}}}}'
