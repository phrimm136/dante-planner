{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": { "enabled": true },
  "enabledManagers": ["argocd", "custom.regex"],
  "minimumReleaseAge": "7 days",
  "automerge": false,
  "argocd": {
    "managerFilePatterns": ["/^deploy/apps/[^/]+\\.yaml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^terraform/modules/fleet/variables\\.tf$/"],
      "matchStrings": [
        "variable \"k3s_version\" \\{[^}]*?default\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["k3s-io/k3s"],
      "dependencyDashboardApproval": true
    }
  ]
}
